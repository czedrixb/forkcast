# Supabase Postgres, via Prisma's pg driver adapter.
# DATABASE_URL: pooled connection (transaction mode, port 6543) — used at runtime.
# DIRECT_URL: direct connection (port 5432) — used by `prisma migrate`.
# Get both from Supabase Project Settings > Database > Connect.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# The scan feature tries each of these in order — Anthropic, then OpenAI,
# then Gemini — falling through to the next one if a call fails (bad key,
# rate limit, etc). At least one is required for the scan feature to work;
# with none set, scanning returns a friendly error instead of a result.
# GEMINI_API_KEY is free to get from Google AI Studio (aistudio.google.com/apikey)
# and makes a good zero-cost last resort.
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="..."

# Pins the scan feature to exactly one provider, with no cascade/fallback:
#   mock       — deterministic sample estimates, no AI call, no cost. Used by
#                the public portfolio deployment and Playwright e2e so a demo
#                environment can never incur real AI spend regardless of
#                which real keys are configured.
#   anthropic | openai | gemini — pins the cascade to just that provider.
# Left unset, the key-presence cascade above is unchanged.
# AI_PROVIDER="mock"

# Dev server runs on 3200 by default (see package.json) — port 5000 is
# reserved by HTTP.sys on some Windows machines, and 3000 may already be
# taken by another local project's dev server.
